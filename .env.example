# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather. Retrieve CHAT_ID from getUpdates API response.
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Magalu Object Storage (default cloud provider) ────────────────────────────
MAGALU_KEY=your_access_key
MAGALU_SECRET=your_secret_key

# ── AWS S3 (set services.cloud.provider: aws in YAML to use) ─────────────────
# boto3 reads these standard env vars automatically — region is set in YAML.
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# ── GCP (set services.cloud.provider: gcp in YAML to use) ────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# ── Magalu custom endpoint override (optional, overrides the region-derived URL) ──
# MAGALU_URL=https://br-ne1.magaluobjects.com

# ── Health Monitoring (healthchecks.io or compatible dead-man switch) ─────────
HC_PING_URL=https://hc-ping.com/your-uuid-here

# ── Log Levels (DEBUG | INFO | WARNING | ERROR) ───────────────────────────────
LOG_LEVEL_MAIN=INFO
LOG_LEVEL_POLICY_ENGINE=DEBUG
LOG_LEVEL_FEATURE_EXTRACTOR=DEBUG
LOG_LEVEL_SMART_RECORDER=DEBUG
LOG_LEVEL_TELEGRAM=INFO
LOG_LEVEL_SERVICES=INFO

# =============================================================================
# APT Repository Publishing  (make publish-deb)
# =============================================================================
# GPG key setup (one-time):
#   gpg --full-generate-key
#   gpg --armor --export <KEY_ID> > ai-acoustic-monitor.gpg.pub
#   gpg --armor --export-secret-keys <KEY_ID> > ai-acoustic-monitor.gpg.key
# =============================================================================
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_ENDPOINT="https://br-se1.magaluobjects.com"
S3_REGION="br-se1"
S3_PREFIX="ai-acoustic-monitor"

GPG_KEY_ID="your-gpg-key-fingerprint"
GPG_KEY_FILE="ai-acoustic-monitor.gpg.key"
GPG_PUBKEY_FILE="ai-acoustic-monitor.gpg.pub"

DEB_S3_BUCKET="ai-acoustic-monitor"
